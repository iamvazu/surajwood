# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model Configuration (claude-3-5-sonnet-20241022 or claude-3-5-haiku-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# WhatsApp Admin / Escalation Phone Numbers (comma separated with country code, e.g. 919009171819@c.us)
ADMIN_WHATSAPP_NUMBERS=919009171819@c.us

# Web Dashboard & Healthcheck Port
PORT=3005

# Session & Cache Directory
SESSION_DATA_PATH=./data/session

# Message Debounce Delay in Milliseconds (groups multiple incoming texts into 1 response)
DEBOUNCE_DELAY_MS=4000

# Human Takeover Silence Duration (minutes to mute AI after human sales rep types on phone)
HUMAN_TAKEOVER_MINUTES=45
